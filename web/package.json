{
  "name": "kanji-gacha-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "e2e": "playwright test",
    "types": "openapi-typescript ../api/openapi.yaml -o src/api.generated.ts",
